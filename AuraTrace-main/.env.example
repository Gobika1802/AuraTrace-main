# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/auratrace

# ---- API server ----
PORT=3001
# Public origin of the web app (used in notification email links + CORS in dev)
APP_URL=http://localhost:5173
# Comma separated extra origins allowed to call the API with credentials (dev)
CORS_ORIGINS=http://localhost:5173
# Set to "production" in deployed environments
NODE_ENV=development

# ---- Monitoring engine ----
# Run the monitoring worker inside the API process (set false to run `npm run worker` separately)
WORKER_ENABLED=true
# How often the scheduler wakes up to look for due monitors (seconds)
SCHEDULER_TICK_SECONDS=10
# Max concurrent HTTP checks across all monitors
CHECK_CONCURRENCY=10
# Comma separated list of ports monitors are allowed to target
ALLOWED_PORTS=80,443,8080,8443

# ---- Email (SMTP) ----
# Leave SMTP_URL empty to disable outbound email (delivery attempts are logged as "skipped").
# Example: smtp://user:pass@smtp.example.com:587  or  smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="AuraTrace <no-reply@auratrace.local>"
# Dev only: write outbound emails as .html files into server/.emails instead of sending
ALLOW_FILE_EMAIL=true
